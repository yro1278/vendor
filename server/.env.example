# Tri-M Vendor Management API — backend configuration.
# Copy to .env and set the real values for your MySQL server.
# The server reads these values via node --env-file-if-exists=.env

PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tri_m_vendor
DB_POOL_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Automatically create tables and seed reference data on startup
AUTO_MIGRATE=true